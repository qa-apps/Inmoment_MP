{
  "mcpServers": {
    "playwright": {
      "command": "node",
      "args": ["./node_modules/@playwright/mcp/index.js"],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "./node_modules/.playwright"
      }
    },
    "ultimate-playwright": {
      "command": "node", 
      "args": ["./node_modules/ultimate-playwright-mcp/dist/index.js"],
      "env": {
        "PLAYWRIGHT_BROWSERS_PATH": "./node_modules/.playwright"
      }
    }
  }
}
